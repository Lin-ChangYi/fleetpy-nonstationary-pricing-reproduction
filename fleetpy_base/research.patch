+def _stable_uniform_01(*values):
+    mask = (1 << 64) - 1
+    x = 0x9E3779B97F4A7C15
+    for value in values:
+        v = int(value) & mask
+        x = (x + v + 0x9E3779B97F4A7C15) & mask
+        x = ((x ^ (x >> 30)) * 0xBF58476D1CE4E5B9) & mask
+        x = ((x ^ (x >> 27)) * 0x94D049BB133111EB) & mask
+        x = (x ^ (x >> 31)) & mask
+    return float(((x >> 11) + 0.5) / float(1 << 53))
+
+
